{
  "name": "memelab",
  "private": true,
  "type": "module",
  "scripts": {
    "seed:build": "node scripts/build-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply memelab --local",
    "db:seed:local": "npm run seed:build && wrangler d1 execute memelab --local --file=data/seed.sql",
    "db:migrate": "wrangler d1 migrations apply memelab --remote",
    "db:seed": "npm run seed:build && wrangler d1 execute memelab --remote --file=data/seed.sql",
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "test": "node --test test/*.test.mjs",
    "deploy:scan": "wrangler deploy --config worker/wrangler.toml",
    "build:apps-script": "node scripts/build-apps-script.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0"
  }
}
